    { "id": "e-mail", "fromNode": "api", "fromSide": "right", "toNode": "email", "toSide": "left", "label": "mail", "color": "3" },
    { "id": "e-copy", "fromNode": "fetch", "fromSide": "left", "toNode": "quran", "toSide": "right" },
    { "id": "e-ci", "fromNode": "ci", "fromSide": "left", "toNode": "checks", "toSide": "right", "color": "3" }
