    { "id": "e-calls", "fromNode": "pages", "fromSide": "right", "toNode": "rewrite", "toSide": "left", "label": "API calls", "color": "3" },
    { "id": "e-https", "fromNode": "rewrite", "fromSide": "right", "toNode": "api", "toSide": "left", "label": "HTTPS", "color": "3" },
    { "id": "e-inside", "fromNode": "api", "fromSide": "bottom", "toNode": "modules", "toSide": "top", "color": "3" },
